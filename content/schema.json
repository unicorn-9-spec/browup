{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://browup.local/content/schema.json",
  "title": "BrowUp content pack",
  "description": "Prompts for one sign language. Reviewers edit this file; code never contains sign-language content. A pack without a reviewer is refused unless the developer flag --dev-unreviewed is set, and then it is shown with an UNREVIEWED banner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["packId", "language", "languageName", "version", "prompts", "sets", "sources"],
  "properties": {
    "packId": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
    "language": { "type": "string", "minLength": 2, "maxLength": 12, "description": "Short code shown in the UI, e.g. ASL, BSL, PSL." },
    "languageName": { "type": "string", "minLength": 2, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "reviewer": {
      "description": "The Deaf signer or qualified teacher who reviewed every prompt. Required for the pack to be presented as correct.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "date"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "role": { "type": "string", "minLength": 2, "maxLength": 200, "description": "e.g. 'Deaf ASL instructor'." },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "credit": { "type": "string", "maxLength": 300, "description": "How the reviewer would like to be credited (README, About)." }
      }
    },
    "notice": { "type": "string", "maxLength": 400 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
          "title": { "type": "string", "minLength": 2, "maxLength": 200 },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "prompts"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
          "title": { "type": "string", "minLength": 2, "maxLength": 80 },
          "description": { "type": "string", "maxLength": 300 },
          "prompts": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "marker", "meaning", "gloss", "span"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
          "marker": { "enum": ["yn", "wh", "neg", "aff", "topic", "cond"] },
          "meaning": { "type": "string", "minLength": 2, "maxLength": 200, "description": "English meaning shown small above the gloss." },
          "gloss": {
            "type": "array", "minItems": 1, "maxItems": 12,
            "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9'\\-+#,.]*$" },
            "description": "Gloss tokens in capitals, one per sign."
          },
          "span": {
            "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 },
            "description": "First and last gloss index under the marker bar (inclusive)."
          },
          "split": { "type": "integer", "minimum": 1, "description": "Topic / conditional: index of the first sign of the comment / result." },
          "windowS": { "type": "number", "minimum": 3, "maximum": 7 },
          "notes": { "type": "string", "maxLength": 400 },
          "sources": { "type": "array", "items": { "type": "string" } },
          "reviewed": { "type": "boolean", "description": "Set by the reviewer per prompt." }
        }
      }
    }
  }
}
